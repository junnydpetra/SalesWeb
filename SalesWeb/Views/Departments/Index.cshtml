@model IEnumerable<SalesWeb.Models.Department>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-stripped table-hover">
    <thead>
        <tr class="bg-success">
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => department.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-outline-info">Edit</a> |
                <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-outline-success">Details</a> |
                <a asp-action="Delete" asp-route-id="@department.Id" class="btn btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
